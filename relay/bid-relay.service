# systemd unit for the relay. Install:
#   sudo cp bid-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bid-relay
# Edit WorkingDirectory / User / RELAY_TOKEN first.
[Unit]
Description=Bid Assistant relay
After=network.target

[Service]
WorkingDirectory=/home/user/FB/relay
ExecStart=/usr/bin/env node server.js
Environment=PORT=8787
Environment=RELAY_TOKEN=change-me-to-a-long-random-secret
Restart=always
User=user

[Install]
WantedBy=multi-user.target
