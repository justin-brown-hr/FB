{
  "manifest_version": 3,
  "name": "Bid Assistant B2 (Freelancer)",
  "version": "1.4.0",
  "description": "Adds 'Copy project' and 'Write bid' buttons to Freelancer.com project pages. Write bid asks B1 (Claude) and fills your proposal.",
  "key": "",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "management",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.freelancer.com/*",
        "https://www.freelancer.in/*",
        "https://www.freelancer.co.uk/*",
        "https://www.freelancer.ca/*",
        "https://www.freelancer.com.au/*",
        "https://www.freelancer.co.nz/*",
        "https://www.freelancer.ie/*",
        "https://www.freelancer.pk/*",
        "https://www.freelancer.ph/*",
        "https://www.freelancer.hk/*",
        "https://www.freelancer.sg/*",
        "https://www.freelancer.my/*",
        "https://www.freelancer.co.id/*",
        "https://www.freelancer.com.bd/*",
        "https://www.freelancer.co.za/*",
        "https://www.freelancer.com.ng/*",
        "https://www.freelancer.co.ke/*",
        "https://www.freelancer.ae/*",
        "https://www.freelancer.de/*",
        "https://www.freelancer.fr/*",
        "https://www.freelancer.es/*",
        "https://www.freelancer.it/*",
        "https://www.freelancer.nl/*",
        "https://www.freelancer.pt/*",
        "https://www.freelancer.se/*",
        "https://www.freelancer.pl/*",
        "https://www.freelancer.ro/*",
        "https://www.freelancer.mx/*",
        "https://www.freelancer.cl/*",
        "https://www.freelancer.com.ar/*",
        "https://www.freelancer.com.pe/*",
        "https://www.freelancer.com.jm/*",
        "https://www.freelancer.ec/*",
        "https://www.freelancer.hn/*",
        "https://www.freelancer.uy/*",
        "https://www.freelancer.jp/*",
        "https://freelancer.com/*"
      ],
      "js": [
        "parse.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Bid Assistant B2 (Freelancer)",
    "default_popup": "popup.html"
  }
}
