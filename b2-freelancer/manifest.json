{
  "manifest_version": 3,
  "name": "Bid Assistant B2 (Freelancer)",
  "version": "1.0.0",
  "description": "Adds 'Copy project' and 'Write bid' buttons to Freelancer.com project pages. Write bid asks B1 (Claude) and fills your proposal.",
  "key": "",
  "permissions": ["clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.freelancer.com/*", "https://freelancer.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
