{
  "manifest_version": 3,
  "name": "Bid Assistant B1 (Claude)",
  "version": "1.2.0",
  "description": "Receives Freelancer project details from B2, asks your pinned BID chat on claude.ai, and returns the bid proposal.",
  "key": "",
  "permissions": [
    "alarms",
    "management",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "ids": [
      "*"
    ]
  },
  "action": {
    "default_title": "Bid Assistant B1 settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
